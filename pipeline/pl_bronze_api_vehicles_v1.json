				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-ev-intelligence-dev-p.vault.azure.net/secrets/voltgrid-username/?api-version=7.0",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "act_get_password",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "act_get_username",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-ev-intelligence-dev-p.vault.azure.net/secrets/voltgrid-password/?api-version=7.0",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "act_api_login",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "act_get_password",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://ev-project-navy-mu.vercel.app/api/auth/login/",
					"body": {
						"value": "@concat('{\"username\":\"', activity('act_get_username').output.value, '\",\"password\":\"', activity('act_get_password').output.value, '\"}')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "act_set_token",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "act_api_login",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_token",
					"value": {
						"value": "@activity('act_api_login').output.token",
						"type": "Expression"
					}
				}
			},
			{
				"name": "act_set_ingestion_date",
				"type": "SetVariable",
				"dependsOn": [
