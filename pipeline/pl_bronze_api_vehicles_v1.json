							"value": "@concat('Token ', variables('v_token'))",
							"type": "Expression"
						}
					},
					"url": {
						"value": "@concat('https://ev-project-navy-mu.vercel.app/api/db/vehicles/?page=1&page_size=100&updated_after=', variables('v_watermark'))",
						"type": "Expression"
